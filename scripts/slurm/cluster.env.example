# Cluster settings of the SLURM launchers. Copy this file to scripts/slurm/cluster.env, which
# is not tracked, and fill it in.

# Read by sbatch when a job is submitted.
export SBATCH_ACCOUNT=my-account
export SBATCH_PARTITION=my-gpu-partition

# Used on the compute node before the script runs.
MODULE_PATHS=""                          # extra module trees, passed to `module use`
MODULES="CUDA/12.8.0 Python/3.11.5"     # modules to load, empty for none
VENV=/path/to/venv                       # virtualenv with the dependencies of README.md
export HF_HOME=/path/to/hf_cache         # Hugging Face cache for all model weights
